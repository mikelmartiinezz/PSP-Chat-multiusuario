               </HBox.margin>
            </Label>
            <TextField fx:id="txtPuerto" maxWidth="50.0" text="5000">
               <HBox.margin>
                  <Insets right="5.0" />
               </HBox.margin>
            </TextField>
            <Label text="Usuario:">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Label>
            <TextField fx:id="txtUsuario" maxWidth="100.0">
               <HBox.margin>
                  <Insets right="5.0" />
